<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for OnePlus Nord 3 5G / Ace 2V (vitamin, MT6983)
  on PixelOS sixteen-qpr2 (Android 16 QPR2, LineageOS 23.2 base).

  ROM manifest: https://github.com/PixelOS-AOSP/android_manifest  branch sixteen-qpr2
  (the older PixelOS-AOSP/manifest repo is abandoned, do not use it)

  Device sources: https://github.com/mt6983-development (org README lists them)

  Remotes are declared here so nothing falls back to the ROM default remote
  (android.googlesource.com). Names avoid PixelOS's own remote names
  (aosp, lineageos, github, gitlab).
-->
<manifest>
    <remote name="vitamin-dev"        fetch="https://github.com/Adarsh0127-Elite" revision="lineage-23.2" />
    <remote name="vitamin-dev-gitlab" fetch="https://gitlab.com/Adarsh0127-Elite" revision="lineage-23.2" />
    <remote name="mt6983-dev"         fetch="https://github.com/mt6983-development" revision="lineage-23.2" />

    <!-- Device tree and prebuilt kernel (Image.gz, dtb, modules) -->
    <project name="android_device_oneplus_vitamin"        path="device/oneplus/vitamin"        remote="vitamin-dev" />
    <project name="android_device_oneplus_vitamin-kernel" path="device/oneplus/vitamin-kernel" remote="vitamin-dev-gitlab" />

    <!-- Proprietary blobs -->
    <project name="proprietary_vendor_oneplus_vitamin"    path="vendor/oneplus/vitamin"        remote="vitamin-dev-gitlab" />

    <!-- MediaTek IMS (device.mk inherits vendor/mediatek/ims/ims.mk) -->
    <project name="android_vendor_mediatek_ims"           path="vendor/mediatek/ims"           remote="vitamin-dev" revision="android-16-qpr2" />

    <!-- OPlus and MediaTek hardware, MediaTek vendor sepolicy -->
    <project name="hardware_oplus"                        path="hardware/oplus"                remote="mt6983-dev" />
    <project name="android_hardware_mediatek"             path="hardware/mediatek"             remote="mt6983-dev" />
    <project name="android_device_mediatek_sepolicy_vndr" path="device/mediatek/sepolicy_vndr" remote="mt6983-dev" />

    <!--
      Kernel source. Required even though the prebuilt kernel is used:
      vendor/lineage's generated_kernel_includes runs `make headers_install`
      against TARGET_KERNEL_SOURCE (kernel/common/android12-5.10).
      Kernel modules source stays opt-in: repo sync -c -g default,kernel
      To rebuild the kernel use https://github.com/mt6983-development/kernel_manifest
    -->
    <project name="android_kernel_oneplus_mt6983"         path="kernel/common/android12-5.10"   remote="mt6983-dev" />
    <project name="android_kernel_modules_oneplus_mt6983" path="kernel/mediatek/mt6983-modules" remote="mt6983-dev" groups="notdefault,kernel" />
</manifest>
